        const bmi = (w / (h * h)).toFixed(1);
        bmiScoreDisplay.textContent = bmi;

        targetProteinDisplay.textContent = `${Math.round(w * 2)} g / நாள்`;
        targetCaloriesDisplay.textContent = `${Math.round(w * 33)} kcal`;

        if (bmi < 18.5) {
          bmiCategoryText.textContent = 'Underweight (குறைந்த எடை)';
          bmiCategoryText.className = 'font-bold text-yellow-400';
          bmiStatusBadge.textContent = 'குறைந்த எடை';
