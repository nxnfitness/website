      const bloodGroup = document.getElementById('newMemberBloodGroup').value;
      const age = document.getElementById('newMemberAge').value;
      const goal = document.getElementById('newMemberGoal').value;
      const branch = document.getElementById('newMemberBranch').value;
      const dob = document.getElementById('newMemberDOB').value;
      const maritalStatus = document.getElementById('newMemberMaritalStatus').value;
      const address = document.getElementById('newMemberAddress').value;

      if (!name || !phone) {
        showToast('விவரம் தேவை', 'பெயர் மற்றும் போன் எண்ணை உள்ளிடவும்', 'fa-triangle-exclamation');
        return;
      }

      const newId = `NXN-${String(appState.admin.members.length + 1).padStart(3, '0')}`;
      const newMember = {
        id: newId,
        name: name,
        phone: phone,
        plan: plan,
        fee: fee,
        expiry: 'Nov 30, 2026',
        status: 'Active',
        paid: isPaid,
        photo: currentUploadedPhoto,
        bloodGroup: bloodGroup,
        age: age,
        goal: goal,
        branch: branch,
        dob: dob,
        maritalStatus: maritalStatus,
        address: address,
        admissionDate: new Date().toISOString().split('T')[0]
      };

      appState.admin.members.unshift(newMember);
      saveAdminData();
      updateAdminMetrics();
      renderAdminMembers(currentMemberFilter);
      renderAdminDues();
      addMemberModal.classList.add('hidden');
      showToast('அட்மிஷன் முடிந்தது!', `${name} அட்மிஷன் மற்றும் பயோ விவரங்கள் சேமிக்கப்பட்டது (ID: ${newId})`, 'fa-user-check');
    });

    function saveAdminData() {
      try {
        localStorage.setItem('nxn_admin_members', JSON.stringify(appState.admin.members));
        localStorage.setItem('nxn_admin_expenses', JSON.stringify(appState.admin.expenses));
        localStorage.setItem('nxn_admin_enquiries', JSON.stringify(appState.admin.enquiries));
      } catch(e) {}
    }

    // Change Admin Password Logic
    document.getElementById('updateAdminPasswordBtn').addEventListener('click', () => {
      const current = document.getElementById('inputCurrentAdminPass').value.trim();
      const newPass = document.getElementById('inputNewAdminPass').value.trim();

      if (current !== appState.admin.pin) {
        showToast('பாஸ்வேர்டு தவறு', 'தற்போதைய பாஸ்வேர்டு தவறானது!', 'fa-xmark');
        return;
      }
      if (!newPass || newPass.length < 4) {
        showToast('குறைந்தபட்ச நீளம்', 'புதிய பாஸ்வேர்டு குறைந்தது 4 எழுத்துக்கள் அல்லது எண்கள் இருக்க வேண்டும்', 'fa-triangle-exclamation');
        return;
      }

      appState.admin.pin = newPass;
      try {
        localStorage.setItem('nxn_admin_pin', newPass);
      } catch(e) {}
      document.getElementById('inputCurrentAdminPass').value = '';
      document.getElementById('inputNewAdminPass').value = '';
      showToast('பாஸ்வேர்டு புதுப்பிக்கப்பட்டது!', 'அட்மின் பாஸ்வேர்டு வெற்றிகரமாக மாற்றப்பட்டது', 'fa-key');
    });

    // Export Data Logic
    document.getElementById('exportMemberDataBtn').addEventListener('click', () => {
      const data = {
        branch: appState.admin.activeBranch,
        members: appState.admin.members,
        enquiries: appState.admin.enquiries,
        expenses: appState.admin.expenses
      };
      const json = JSON.stringify(data, null, 2);
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(json).catch(() => {});
      }
      showToast('நகலெடுக்கப்பட்டது', 'முழு ஜிம் தரவு கிளிப்போர்டில் நகலெடுக்கப்பட்டது!', 'fa-copy');
    });

    document.getElementById('resetDemoDataBtn').addEventListener('click', () => {
      showToast('தகவல்', 'மாதிரி தரவு மீட்டமைக்கப்பட்டது', 'fa-rotate-right');
    });
</script>
</body>
</html>
