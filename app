      if (!split || !splitDaysPills) return;

      splitDaysPills.innerHTML = '';
      split.days.forEach((day, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `px-3 py-1.5 rounded-xl text-xs font-bold whitespace-nowrap transition ${idx === 0 ? 'bg-gold-500 text-dark-950 shadow' : 'bg-dark-800 text-gray-300 border border-dark-700'}`;
