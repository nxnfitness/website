    // Update Admin KPI Metrics dynamically from real user entries
    function updateAdminMetrics() {
      const total = appState.admin.members.length;
      const activeMembers = appState.admin.members.filter(m => m.paid && m.status === 'Active').length;
      const inactiveMembers = total - activeMembers;
      const dues = appState.admin.members.filter(m => !m.paid);
      const totalDuesAmount = dues.reduce((sum, m) => sum + (parseInt(m.fee) || 0), 0);
      const totalRevenue = appState.admin.members.filter(m => m.paid).reduce((sum, m) => sum + (parseInt(m.fee) || 0), 0);
      const totalExpenses = appState.admin.expenses.reduce((sum, e) => sum + (parseInt(e.amount) || 0), 0);
      const netProfit = totalRevenue - totalExpenses;
      const margin = totalRevenue > 0 ? ((netProfit / totalRevenue) * 100).toFixed(1) : '0';

      document.getElementById('adminTotalMembersCount').textContent = total;
      const badgeEl = document.getElementById('adminActiveBadge');
      if (badgeEl) badgeEl.textContent = `${activeMembers} Active • ${inactiveMembers} Inactive`;
      
      document.getElementById('adminMonthRevenue').textContent = `₹${totalRevenue.toLocaleString('en-IN')}`;
      document.getElementById('adminPendingCount').textContent = `${dues.length} Members Due`;
      document.getElementById('adminPendingDues').textContent = `₹${totalDuesAmount.toLocaleString('en-IN')}`;
      document.getElementById('feesDueTotalBadge').textContent = `₹${totalDuesAmount.toLocaleString('en-IN')} Due`;

      if (appState.admin.role === 'admin') {
        document.getElementById('adminNetProfitDisplay').textContent = `₹${netProfit.toLocaleString('en-IN')}`;
        document.getElementById('adminExpenseSubtitle').textContent = `Expenses: ₹${totalExpenses.toLocaleString('en-IN')}`;
      } else {
        document.getElementById('adminNetProfitDisplay').textContent = 'Staff View';
        document.getElementById('adminExpenseSubtitle').textContent = 'Admin Only';
      }
      document.getElementById('totalExpensesAmount').textContent = `₹${totalExpenses.toLocaleString('en-IN')}`;
      document.getElementById('profitMarginPercent').textContent = `${margin}%`;
    }

