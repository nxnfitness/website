          bmiCategoryText.textContent = 'Overweight (அதிக எடை)';
          bmiCategoryText.className = 'font-bold text-orange-400';
          bmiStatusBadge.textContent = 'அதிக எடை';
          bmiStatusBadge.className = 'text-[10px] px-2 py-0.5 rounded-full bg-orange-500/20 text-orange-400 font-bold border border-orange-500/30';
