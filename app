    function updateCollectionsUI() {
      const todayDateStr = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-');
      
      // Calculate today's collection from payments with today's date
      let todayTotal = 0;
      let thisMonthTotal = 180500; // Baseline October collection from members
      let lifetimeTotal = 3850000; // Baseline all-time revenue since inception

      appState.admin.payments.forEach(p => {
        if (p.date === '30-Oct-2026' || p.date === todayDateStr || p.date.includes('Today')) {
          todayTotal += parseInt(p.amount) || 0;
        }
      });

      // Sum of all additional payments recorded live
      const liveExtraPaid = appState.admin.payments.reduce((sum, p) => sum + (parseInt(p.amount) || 0), 0);
      thisMonthTotal += (todayTotal - 4000 > 0 ? (todayTotal - 4000) : 0);
      lifetimeTotal += (todayTotal - 4000 > 0 ? (todayTotal - 4000) : 0);

      const collTodayDisplay = document.getElementById('collTodayDisplay');
      const collThisMonthDisplay = document.getElementById('collThisMonthDisplay');
      const collLastMonthDisplay = document.getElementById('collLastMonthDisplay');
